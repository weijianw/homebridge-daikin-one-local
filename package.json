{
  "name": "homebridge-daikin-one-local",
  "displayName": "Daikin One Local",
  "type": "module",
  "version": "0.1.7",
  "private": true,
  "description": "Local LAN integration for Daikin One+ and One Touch thermostats",
  "author": "weijianw",
  "license": "Apache-2.0",
  "homepage": "https://github.com/weijianw/homebridge-daikin-one-local#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/weijianw/homebridge-daikin-one-local.git"
  },
  "bugs": {
    "url": "https://github.com/weijianw/homebridge-daikin-one-local/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "lint": "eslint src test --max-warnings=0",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ]
}
